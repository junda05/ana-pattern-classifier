# Docker Compose configuration of the ANA Pattern Classifier (docker-compose.yml).
# Copy to .env and replace every change-me value; .env is never committed.
# The API refuses to start in production mode while a secret still starts with "change-me".
# Avoid "$" in values (Compose would try to expand it).

# ---- Database (SQL Server 2022, service "db") --------------------------------
# SQL Server password policy: at least 8 characters with three of: uppercase,
# lowercase, digits and symbols (e.g. a long random string plus "Aa1!").
# The container only uses it on first start; changing it later needs `docker compose down -v`.
MSSQL_SA_PASSWORD=change-me-Strong-Passw0rd
# Database created by the one-shot "db-init" service; the API applies the migrations on start.
DB_NAME=ana_classifier
# Dedicated SQL login of the API, created (idempotently) by "db-init" with db_owner on
# DB_NAME only; the API never connects as sa. Letters, digits and "_" only, never "sa".
# Same password policy as MSSQL_SA_PASSWORD; "db-init" re-applies it on every start.
DB_APP_USERNAME=ana_app
DB_APP_PASSWORD=change-me-App-Passw0rd
# Encryption of the API <-> SQL Server connection. The defaults suit the private Compose
# network. Production should set DB_ENCRYPT=true and DB_TRUST_SERVER_CERTIFICATE=false,
# with a real certificate (trusted by the API) installed on SQL Server.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ---- Prediction service (service "predictor", not published on the host) -----
# Shared secret between the API and the predictor; never sent to the browser.
PREDICTOR_API_KEY=change-me-to-a-long-random-key
# Per-request timeout of the API when it calls the predictor (milliseconds).
PREDICTOR_TIMEOUT_MS=60000
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
PREDICTOR_LOG_LEVEL=INFO

# ---- REST API (service "api", http://localhost:8001) --------------------------
# IANA timezone used for report dates.
APP_TIMEZONE=UTC
# Browser origin allowed by CORS (the web UI).
FRONTEND_URL=http://localhost:3000
# Public base URL of the API (used to build image URLs).
API_BASE_URL=http://localhost:8001
JWT_SECRET=change-me-to-a-long-random-string
# HMAC key that signs every prediction returned by the API; results can only be saved
# with predictions signed for the uploaded image. Required.
PREDICTION_SIGNING_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRATION=40m
JWT_REFRESH_EXPIRATION=2h
PASSWORD_RESET_TOKEN_EXPIRATION=30m
# Largest accepted upload in bytes (10 MB).
MAX_FILE_SIZE=10485760
# Per-IP rate limits of the authentication routes: requests per window and route
# (login; refresh-access; request-password-reset, validate-admin-and-token and
# reset-password). Above the limit the API answers 429.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_REFRESH=30
AUTH_RATE_LIMIT_PASSWORD_RESET=5
# Leave empty unless the API runs behind a reverse proxy. Then set Express "trust proxy"
# (e.g. 1 for one proxy hop) so the rate limits see the client IP from X-Forwarded-For;
# never set it when clients reach the API directly (they could spoof that header).
TRUST_PROXY=

# Email (SendGrid) for password-reset notifications. Optional: with an empty key no
# email is sent. The API image runs with NODE_ENV=production, so it then only logs
# that the notification was skipped (never the reset link); the reset link is logged
# at WARN level only when the API runs outside production (e.g. `npm run start:dev`).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=ANA Pattern Classifier

# First administrator, created with:
#   docker compose exec api node dist/scripts/create-admin-user.js
# ADMIN_EMAIL also receives password-reset requests.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=System Administrator
ADMIN_PROFESSIONAL_CARD=ADMIN-0001

# ---- Web UI (service "web", http://localhost:3000) ----------------------------
# Inlined into the JavaScript bundle at build time: rebuild (`docker compose build web`) after a change.
REACT_APP_API_BASE_URL=http://localhost:8001/api/v1
# Origin of REACT_APP_API_BASE_URL, allowed by the Content-Security-Policy of the web server.
API_ORIGIN=http://localhost:8001
# Laboratory identity printed on clinical reports.
REACT_APP_LAB_NAME=Clinical Immunology Laboratory
REACT_APP_LAB_DEPARTMENT=Special Immunology
REACT_APP_LAB_ADDRESS=
