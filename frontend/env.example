PORT=3000
# NestJS API base URL (includes the /api/v1 prefix).
# Image predictions are proxied by the API (POST /predictions/analyze); the
# browser never receives prediction-service credentials.
REACT_APP_API_BASE_URL=http://localhost:8001/api/v1
# Laboratory identity printed on clinical reports.
REACT_APP_LAB_NAME=Clinical Immunology Laboratory
REACT_APP_LAB_DEPARTMENT=Special Immunology
REACT_APP_LAB_ADDRESS=
