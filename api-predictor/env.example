# API keys accepted in "Authorization: Bearer <key>" (comma-separated for rotation).
# Empty rejects every request.
API_KEYS=change-me-to-a-long-random-key
APP_NAME="ANA Pattern Classifier - Prediction API"
# When true, /docs, /redoc and /openapi.json are served (default false; enable for local development only).
DEBUG=true
# When false, only the general-level model is used.
ENABLE_HIERARCHICAL_CLASSIFICATION=true
# Browser origins allowed by CORS (comma-separated), e.g. http://localhost:3000.
# Leave empty when only the API server calls this service (recommended).
ALLOWED_ORIGINS=
# Log level of the service: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# Largest accepted image in pixels (width x height), checked before decoding.
MAX_IMAGE_PIXELS=50000000
