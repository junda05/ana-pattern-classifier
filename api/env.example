# Server
PORT=8001
NODE_ENV=development
# IANA timezone used for stored timestamps and report dates.
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000
# Public base URL of this API (used to build image URLs).
API_BASE_URL=http://localhost:8001

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION=40m
JWT_REFRESH_EXPIRATION=2h
PASSWORD_RESET_TOKEN_EXPIRATION=30m
# Per-IP rate limits of the authentication routes: requests per window and route
# (login; refresh-access; request-password-reset, validate-admin-and-token and
# reset-password). Above the limit the API answers 429.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_REFRESH=30
AUTH_RATE_LIMIT_PASSWORD_RESET=5
# Leave empty unless the API runs behind a reverse proxy. Then set Express "trust proxy"
# (e.g. 1 for one proxy hop) so the rate limits see the client IP from X-Forwarded-For.
TRUST_PROXY=

# Database (Microsoft SQL Server). The schema comes from migrations only (synchronize is off):
# create an empty database, then run `npm run migration:run` (or `migration:run:prod` from dist).
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_NAME=ana_classifier
# Use a dedicated login with db_owner on DB_NAME only (not sa) outside local development.
# Connection encryption: the defaults suit a local or private-network server. Production
# should set DB_ENCRYPT=true and DB_TRUST_SERVER_CERTIFICATE=false, with a real
# certificate (trusted by the API) installed on SQL Server.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# File storage
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=10485760

# Prediction service (api-predictor). The API forwards images to it server-side;
# the key must match one of the predictor API_KEYS and is never sent to the browser.
PREDICTOR_URL=http://localhost:8000
PREDICTOR_API_KEY=change-me-to-a-long-random-key
# Per-request timeout in milliseconds.
PREDICTOR_TIMEOUT_MS=60000
# HMAC key that signs every /predictions/analyze answer; the results endpoints only
# save predictions whose signature matches the uploaded image. Required.
PREDICTION_SIGNING_SECRET=change-me-to-another-long-random-string

# Email (SendGrid) for password-reset notifications. Optional: without a key (empty or
# change-me) nothing is emailed; outside production (NODE_ENV != production) the
# notification, including the reset link, is logged at WARN level instead.
SENDGRID_API_KEY=change-me
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=ANA Pattern Classifier

# Initial administrator (npm run seed:admin). ADMIN_EMAIL also receives password-reset requests.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=System Administrator
ADMIN_PROFESSIONAL_CARD=ADMIN-0001
